<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_sense_reorder_list" model="ir.ui.view"><field name="name">stock.sense.reorder.suggestion.list</field><field name="model">stock.sense.reorder.suggestion</field><field name="arch" type="xml">
        <tree decoration-danger="state == 'required'"><header><button name="action_generate_suggestions" type="object" string="Generate Suggestions" class="btn-primary"/></header><field name="product_id"/><field name="warehouse_id"/><field name="current_stock"/><field name="reorder_point"/><field name="average_daily_usage"/><field name="days_until_stockout"/><field name="suggested_quantity"/><field name="state" widget="badge"/><field name="generated_at"/></tree>
    </field></record>
    <record id="view_stock_sense_reorder_form" model="ir.ui.view"><field name="name">stock.sense.reorder.suggestion.form</field><field name="model">stock.sense.reorder.suggestion</field><field name="arch" type="xml">
        <form string="Reorder Suggestion"><header><button name="action_mark_resolved" type="object" string="Mark Resolved" class="btn-primary" invisible="state != 'required'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="product_id"/><field name="warehouse_id"/><field name="current_stock"/><field name="minimum_stock"/><field name="average_daily_usage"/></group><group><field name="lead_time_days"/><field name="safety_stock"/><field name="reorder_point"/><field name="suggested_quantity"/><field name="days_until_stockout"/></group></group><group string="Why this is flagged"><field name="reason" nolabel="1"/></group></sheet></form>
    </field></record>
    <record id="action_stock_sense_reorder" model="ir.actions.act_window"><field name="name">Reorder Suggestions</field><field name="res_model">stock.sense.reorder.suggestion</field><field name="view_mode">tree,form</field></record>
</odoo>

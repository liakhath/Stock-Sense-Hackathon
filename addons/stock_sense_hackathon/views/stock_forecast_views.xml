<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Forecast List View ─── -->
    <record id="view_stock_sense_forecast_list" model="ir.ui.view">
        <field name="name">stock.sense.forecast.list</field>
        <field name="model">stock.sense.forecast</field>
        <field name="arch" type="xml">
            <list string="AI Forecasts"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'running'">
                <field name="forecast_date"/>
                <field name="product_tmpl_id"/>
                <field name="algorithm"/>
                <field name="forecast_start"/>
                <field name="forecast_end"/>
                <field name="horizon_days"/>
                <field name="forecasted_qty"/>
                <field name="forecasted_qty_min"/>
                <field name="forecasted_qty_max"/>
                <field name="confidence_score" widget="progressbar"
                       options="{'editable': False}"/>
                <field name="mae"/>
                <field name="r2_score"/>
                <field name="training_data_points"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ─── Forecast Form View ─── -->
    <record id="view_stock_sense_forecast_form" model="ir.ui.view">
        <field name="name">stock.sense.forecast.form</field>
        <field name="model">stock.sense.forecast</field>
        <field name="arch" type="xml">
            <form string="AI Demand Forecast">
                <header>
                    <button name="action_run" type="object"
                            string="▶ Run Forecast"
                            class="btn-primary"
                            attrs="{'invisible': [('state', 'not in', ['draft','failed'])]}"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            attrs="{'invisible': [('state', 'not in', ['failed','done'])]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="product_tmpl_id" options="{'no_create': True}"/>
                            <field name="product_id" domain="[('product_tmpl_id', '=', product_tmpl_id)]"/>
                            <field name="algorithm"/>
                            <field name="forecast_date" readonly="1"/>
                        </group>
                        <group string="Forecast Period">
                            <field name="forecast_start"/>
                            <field name="forecast_end"/>
                            <field name="horizon_days" readonly="1"/>
                        </group>
                    </group>

                    <group string="📊 Forecast Results"
                           attrs="{'invisible': [('state', 'not in', ['done'])]}">
                        <group string="Demand">
                            <field name="forecasted_qty"/>
                            <field name="forecasted_qty_min"/>
                            <field name="forecasted_qty_max"/>
                        </group>
                        <group string="Model Quality">
                            <field name="confidence_score" widget="progressbar"
                                   options="{'editable': False}"/>
                            <field name="mae"/>
                            <field name="rmse"/>
                            <field name="r2_score"/>
                            <field name="training_data_points" readonly="1"/>
                        </group>
                    </group>

                    <group string="❌ Error" attrs="{'invisible': [('state', '!=', 'failed')]}">
                        <field name="error_message" nolabel="1" readonly="1"
                               widget="html"/>
                    </group>

                    <field name="notes" placeholder="Optional notes about this forecast..."/>

                    <!-- Daily Breakdown -->
                    <notebook attrs="{'invisible': [('state', '!=', 'done')]}">
                        <page string="📅 Daily Forecast Breakdown">
                            <field name="daily_forecast_line_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="forecast_date"/>
                                    <field name="day_of_week"/>
                                    <field name="forecasted_qty"/>
                                    <field name="actual_qty"/>
                                    <field name="variance" decoration-danger="variance &lt; 0"
                                           decoration-success="variance &gt;= 0"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── Forecast Search View ─── -->
    <record id="view_stock_sense_forecast_search" model="ir.ui.view">
        <field name="name">stock.sense.forecast.search</field>
        <field name="model">stock.sense.forecast</field>
        <field name="arch" type="xml">
            <search string="Search Forecasts">
                <field name="product_tmpl_id"/>
                <field name="algorithm"/>
                <filter string="Completed" name="done" domain="[('state','=','done')]"/>
                <filter string="Failed" name="failed" domain="[('state','=','failed')]"/>
                <filter string="High Confidence" name="high_conf"
                        domain="[('confidence_score','&gt;=',80)]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="by_product"
                            context="{'group_by': 'product_tmpl_id'}"/>
                    <filter string="Algorithm" name="by_algo"
                            context="{'group_by': 'algorithm'}"/>
                    <filter string="Status" name="by_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Forecast Action ─── -->
    <record id="action_stock_sense_forecast" model="ir.actions.act_window">
        <field name="name">AI Forecasts</field>
        <field name="res_model">stock.sense.forecast</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_sense_forecast_search"/>
        <field name="context">{'search_default_done': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI forecasts yet!
            </p>
            <p>Create a forecast to start predicting stock demand with machine learning.</p>
        </field>
    </record>

</odoo>

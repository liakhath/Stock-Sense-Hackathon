<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_stock_sense_adjustment" model="ir.sequence">
            <field name="name">Stock Sense Adjustment</field>
            <field name="code">stock.sense.adjustment</field>
            <field name="prefix">ADJ/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <!-- Cron 1: Check Stock Levels and Generate Alerts -->
        <record id="ir_cron_check_stock_levels" model="ir.cron">
            <field name="name">Stock Sense: Check Stock Levels &amp; Alerts</field>
            <field name="model_id" ref="model_stock_sense_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_stock_levels()</field>

            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Cron 2: Poll IoT Sensors -->
        <record id="ir_cron_poll_iot_sensors" model="ir.cron">
            <field name="name">Stock Sense: Poll IoT Sensors</field>
            <field name="model_id" ref="model_stock_sense_iot_sensor"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_all_sensors()</field>

            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>

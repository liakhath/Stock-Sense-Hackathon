<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_sense_adjustment_reject_wizard_form" model="ir.ui.view">
        <field name="name">stock.sense.adjustment.reject.wizard.form</field>
        <field name="model">stock.sense.adjustment.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Stock Adjustment" create="0" edit="0">
                <group>
                    <field name="adjustment_id"/>
                    <field name="rejection_reason" required="1" placeholder="Explain why this adjustment is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm_rejection" type="object" string="Confirm Rejection" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADJUSTMENT_APPROVAL_THRESHOLD=10
SEED_DEMO_DATA=true
# Supabase -> Connect -> Session pooler URI (real password, no [ ] brackets). Leave empty for in-memory.
DATABASE_URL=

# ---- Auth ----
# true = login required on every /api route. false = old X-User header (only until the frontend has login)
AUTH_REQUIRED=true
# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# true = /api/auth/forgot-password returns the 6-digit code in the response (demo without email)
OTP_DEMO_MODE=true
# Optional: email the reset code (Gmail: smtp.gmail.com, 587, your address, an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

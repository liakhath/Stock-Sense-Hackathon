<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_stock_sense" model="ir.module.category">
            <field name="name">Stock Sense Intelligence</field>
            <field name="description">User roles for Stock Sense AI &amp; IoT System</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_stock_sense_user" model="res.groups">
            <field name="name">StockSense Staff</field>
            <field name="category_id" ref="module_category_stock_sense"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Basic access to view Stock Sense alerts, forecasts, and IoT sensors.</field>
        </record>

        <record id="group_stock_sense_manager" model="res.groups">
            <field name="name">StockSense Manager</field>
            <field name="category_id" ref="module_category_stock_sense"/>
            <field name="implied_ids" eval="[(4, ref('group_stock_sense_user'))]"/>
            <field name="comment">Full access to manage AI forecast models, IoT sensors, and trigger replenishment.</field>
        </record>

        <record id="rule_stock_sense_adjustment_staff_own" model="ir.rule">
            <field name="name">Stock Sense adjustment: staff own requests</field>
            <field name="model_id" ref="model_stock_sense_adjustment"/>
            <field name="groups" eval="[(4, ref('group_stock_sense_user'))]"/>
            <field name="domain_force">[('requested_by', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_stock_sense_adjustment_manager_all" model="ir.rule">
            <field name="name">Stock Sense adjustment: manager all requests</field>
            <field name="model_id" ref="model_stock_sense_adjustment"/>
            <field name="groups" eval="[(4, ref('group_stock_sense_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
